rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function hasStaffProfile() {
      return isSignedIn() && staffDoc().exists();
    }

    function staffPropertyId() {
      return staffDoc().data.propertyId;
    }

    function effectiveRoleId() {
      let staff = staffDoc().data;
      return staff.assignmentType == 'group'
        ? get(/databases/$(database)/documents/properties/$(staff.propertyId)/groups/$(staff.groupId)).data.roleId
        : staff.roleId;
    }

    function isSuperAdmin() {
      return hasStaffProfile() && (
        staffDoc().data.isSuperAdmin == true ||
        staffDoc().data.userType == 'super_admin'
      );
    }

    function canAccessProperty(propertyId) {
      return hasStaffProfile() && (
        isSuperAdmin() ||
        staffPropertyId() == propertyId ||
        (staffDoc().data.accessibleProperties != null && propertyId in staffDoc().data.accessibleProperties)
      );
    }

    function rolePermissions() {
      return get(/databases/$(database)/documents/properties/$(staffPropertyId())/roles/$(effectiveRoleId())).data.permissions;
    }

    function hasPermission(perm) {
      return hasStaffProfile() && (isSuperAdmin() || perm in rolePermissions());
    }

    function canManageAccess() {
      return isSuperAdmin() || hasPermission('roles.manage') || hasPermission('groups.manage') || hasPermission('users.create');
    }

    function canWriteProperty() {
      return isSuperAdmin()
        || hasPermission('rooms.updateStatus')
        || hasPermission('rooms.create')
        || hasPermission('rooms.update')
        || hasPermission('rooms.delete')
        || hasPermission('bookings.create')
        || hasPermission('bookings.update')
        || hasPermission('bookings.checkin')
        || hasPermission('bookings.checkout')
        || hasPermission('bookings.cancel')
        || hasPermission('housekeeping.manage');
    }

    function canManageHousekeeping() {
      return isSuperAdmin() || hasPermission('housekeeping.manage');
    }

    function canManageShifts() {
      return isSuperAdmin() || hasPermission('shifts.manage');
    }

    match /organizations/{orgId} {
      allow read: if true; // Allows onboarding invite verification and workspace lookup
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin() || (
        hasStaffProfile() && staffDoc().data.organizationId == orgId && staffDoc().data.userType == 'org_admin'
      );
    }

    match /staff/{uid} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        request.auth.uid == uid ||
        (hasStaffProfile() && staffDoc().data.propertyId == resource.data.propertyId) ||
        (hasStaffProfile() && staffDoc().data.organizationId != null && staffDoc().data.organizationId == resource.data.organizationId)
      );
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (
          request.auth.uid == uid &&
          request.resource.data.isSuperAdmin != true &&
          request.resource.data.userType != 'super_admin'
        ) ||
        (
          hasStaffProfile() &&
          hasPermission('users.create') &&
          request.resource.data.propertyId == staffPropertyId() &&
          request.resource.data.isSuperAdmin != true &&
          request.resource.data.userType != 'super_admin'
        )
      );
      allow update: if isSuperAdmin() || (
        hasStaffProfile() &&
        hasPermission('users.assign') &&
        resource.data.propertyId == staffPropertyId() &&
        request.resource.data.isSuperAdmin == resource.data.isSuperAdmin &&
        request.resource.data.userType == resource.data.userType
      );
      allow delete: if isSuperAdmin();
    }

    match /properties/{propertyId}/roles/{roleId} {
      allow read: if canAccessProperty(propertyId);
      allow create, update, delete: if canAccessProperty(propertyId)
        && hasPermission('roles.manage')
        && (roleId != 'system-admin' || resource == null);
    }

    match /properties/{propertyId}/groups/{groupId} {
      allow read: if canAccessProperty(propertyId);
      allow create, update, delete: if canAccessProperty(propertyId)
        && hasPermission('groups.manage');
    }

    match /properties/{propertyId}/rooms/{document=**} {
      allow read: if true; // Public guest stay page displays room categories and availability count
      allow write: if canAccessProperty(propertyId) && canWriteProperty();
    }

    match /properties/{propertyId}/guests/{document=**} {
      allow read: if canAccessProperty(propertyId) && hasPermission('guests.view');
      allow write: if canAccessProperty(propertyId) && canWriteProperty();
    }

    match /properties/{propertyId}/bookings/{document=**} {
      allow read: if canAccessProperty(propertyId) && hasPermission('bookings.view');
      allow write: if canAccessProperty(propertyId) && canWriteProperty();
    }

    match /properties/{propertyId}/communications/{document=**} {
      allow read: if canAccessProperty(propertyId) && hasPermission('guests.view');
      allow create: if canAccessProperty(propertyId) && hasPermission('bookings.create');
      allow update, delete: if false;
    }

    match /properties/{propertyId}/messageTemplates/{document=**} {
      allow read: if canAccessProperty(propertyId) && hasPermission('guests.view');
      allow create, update, delete: if canAccessProperty(propertyId) && hasPermission('bookings.create');
    }

    match /properties/{propertyId}/housekeepingTasks/{document=**} {
      allow read: if canAccessProperty(propertyId) && hasPermission('housekeeping.view');
      allow write: if canAccessProperty(propertyId) && canManageHousekeeping();
    }

    match /properties/{propertyId}/maintenanceTickets/{document=**} {
      allow read: if canAccessProperty(propertyId) && hasPermission('housekeeping.view');
      allow write: if canAccessProperty(propertyId) && canManageHousekeeping();
    }

    match /properties/{propertyId}/activityLog/{document=**} {
      allow read: if canAccessProperty(propertyId) && hasPermission('audit.view');
      allow create: if canAccessProperty(propertyId) && canWriteProperty();
      allow update, delete: if false;
    }

    match /properties/{propertyId}/shifts/{document=**} {
      allow read: if canAccessProperty(propertyId) && (hasPermission('audit.view') || canManageShifts());
      allow write: if canAccessProperty(propertyId) && canManageShifts();
    }

    match /properties/{propertyId}/nightAudits/{document=**} {
      allow read: if canAccessProperty(propertyId) && hasPermission('reports.view');
      allow create: if canAccessProperty(propertyId) && hasPermission('reports.view');
      allow update, delete: if false;
    }

    match /properties/{propertyId}/expenses/{document=**} {
      allow read: if canAccessProperty(propertyId) && (hasPermission('reports.view') || canManageShifts());
      allow create: if canAccessProperty(propertyId) && canWriteProperty();
      allow update, delete: if canAccessProperty(propertyId) && (isSuperAdmin() || hasPermission('shifts.manage'));
    }

    match /properties/{propertyId} {
      allow read: if true; // Public stay page needs property details and rates
      allow write: if canAccessProperty(propertyId) && (isSuperAdmin() || hasPermission('rooms.update'));
    }

    match /publicFolios/{token} {
      allow read: if true;
      allow write: if hasStaffProfile() && canWriteProperty();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedbackSubmitted'])
        && request.resource.data.feedbackSubmitted == true;
    }

    match /publicSuggestionForms/{token} {
      allow read: if true;
      allow write: if hasStaffProfile() && hasPermission('rooms.update');
    }

    match /guestSuggestions/{suggestionId} {
      allow read: if hasStaffProfile()
        && resource.data.propertyId == staffPropertyId()
        && hasPermission('guests.view');
      allow create: if request.resource.data.keys().hasAll(['token', 'propertyId', 'propertyName', 'message', 'createdAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 2000
        && request.resource.data.propertyId is string
        && request.resource.data.token is string
        && exists(/databases/$(database)/documents/publicSuggestionForms/$(request.resource.data.token))
        && get(/databases/$(database)/documents/publicSuggestionForms/$(request.resource.data.token)).data.propertyId
          == request.resource.data.propertyId;
      allow update: if hasStaffProfile()
        && resource.data.propertyId == staffPropertyId()
        && hasPermission('guests.view')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if false;
    }
  }
}
